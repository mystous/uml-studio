    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact"/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Bg0}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{StaticResource FgDim}"/></Style>
    <Style Selector="TextBlock.h"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#E8EDF5"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- dock panel header -->
    <Style Selector="Border.dockhead">
      <Setter Property="Background" Value="{StaticResource Bg2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="8,0,4,0"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style Selector="Border.dockhead > Grid > TextBlock.title, Border.dockhead TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#E6ECF5"/>
    </Style>
    <Style Selector="Border.dock">
      <Setter Property="Background" Value="{StaticResource Bg1}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- small flat icon buttons -->
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Bg4}"/>
    </Style>

    <!-- Ribbon -->
    <Style Selector="TabControl.ribbon">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{StaticResource Bg2}"/>
    </Style>
    <Style Selector="TabControl.ribbon > TabItem">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="3,3,0,0"/>
    </Style>
    <Style Selector="TabControl.ribbon > TabItem:selected">
      <Setter Property="Background" Value="{StaticResource Bg2}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="TabControl.ribbon > TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource Bg3}"/>
    </Style>
    <Style Selector="TabControl.ribbon > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource Bg2}"/>
    </Style>
    <Style Selector="TabControl.ribbon > TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Height" Value="2"/>
    </Style>
    <Style Selector="Border.rgroup">
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Padding" Value="6,4,6,0"/>
    </Style>
    <Style Selector="TextBlock.rlabel">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{StaticResource FgFaint}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,2,0,3"/>
    </Style>
    <Style Selector="Button.rbig, ToggleButton.rbig">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="5,4"/>
      <Setter Property="MinWidth" Value="56"/>
      <Setter Property="Height" Value="66"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.rbig PathIcon"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,2,0,3"/></Style>
    <Style Selector="Button.rbig TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="72"/>
      <Setter Property="LineHeight" Value="14"/>
    </Style>
    <Style Selector="Button.rsmall, ToggleButton.rsmall">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="5,1,8,1"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style Selector="Button.rsmall PathIcon, ToggleButton.rsmall PathIcon"><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
    <Style Selector="Button.rbig:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rsmall:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.rsmall:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Bg4}"/>
      <Setter Property="BorderBrush" Value="#4C5C80"/>
    </Style>
    <Style Selector="Button.rbig:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.rsmall:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>
    <Style Selector="ToggleButton.rsmall:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDim}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.rbig:disabled PathIcon, Button.rsmall:disabled PathIcon, Button.icon:disabled PathIcon">
      <Setter Property="Opacity" Value="0.35"/>
    </Style>

    <!-- Quick access bar -->
    <Style Selector="Border.topbar">
      <Setter Property="Background" Value="#10141D"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- Tree (Project Browser) -->
    <Style Selector="TreeView.browser">
      <Setter Property="Background" Value="{StaticResource Bg1}"/>
      <Setter Property="Padding" Value="0,2"/>
    </Style>
    <Style Selector="TreeView.browser TreeViewItem">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="TreeView.browser TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>
    <Style Selector="TreeView.browser TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>
    <Style Selector="TreeView.browser TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#2F5CA8"/>
    </Style>
    <Style Selector="TreeView.browser TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource Bg3}"/>
    </Style>
    <Style Selector="TreeView.browser TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#3567B8"/>
    </Style>

    <!-- Toolbox rows -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Height" Value="25"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Bg3}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDim}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="Border.toolsec">
      <Setter Property="Background" Value="{StaticResource Bg2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="0,1"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>

    <!-- Diagram tabs -->
    <Style Selector="Border.dtab">
      <Setter Property="Background" Value="{StaticResource Bg1}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style Selector="Border.dtab.active">
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Border.dtab.active TextBlock"><Setter Property="Foreground" Value="#1C2433"/></Style>
    <Style Selector="Border.dtab.active Button.icon"><Setter Property="Foreground" Value="#1C2433"/></Style>
    <Style Selector="Border.dtab Button.tabbody">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,0,4,0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.dtab Button.tabbody:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Border.dtab.active Rectangle.pipe"><Setter Property="Fill" Value="{StaticResource Accent}"/></Style>

    <!-- Properties tabs -->
    <Style Selector="TabControl.ptabs">
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabControl.ptabs > TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
    </Style>
    <Style Selector="TabControl.ptabs > TabItem:selected"><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style Selector="TabControl.ptabs > TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="24"/></Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{StaticResource Bg0}"/>
    </Style>

    <!-- Start page cards -->
    <Style Selector="Button.card">
      <Setter Property="Background" Value="#1F2840"/>
      <Setter Property="BorderBrush" Value="#33415F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#263459"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="Button.recent">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.recent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#263459"/>
    </Style>

    <!-- Status bar -->
    <Style Selector="Border.status TextBlock">
      <Setter Property="Foreground" Value="#EAF1FF"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.status Rectangle.sep">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Fill" Value="#3D6DB8"/>
      <Setter Property="Margin" Value="10,4"/>
    </Style>
  </Application.Styles>
</Application>
